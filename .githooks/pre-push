#!/usr/bin/env bun
import * as path from "node:path";

// Pre-push hook: ensures version bump and tags before pushing to main.

// Git sends: $1 = remote name (argv[2]), $2 = remote url (argv[3])
const remoteName = process.argv[2] ?? "origin";

// Git sends: <local ref> <local sha1> <remote ref> <remote sha1> on stdin
const stdin = await new Response(Bun.stdin.stream()).text();
const lines = stdin.trim().split("\n").filter(Boolean);

let pushingMain = false;
for (const line of lines) {
  const parts = line.trim().split(/\s+/);
  const localRef = parts[0] ?? "";
  const localSha = parts[1] ?? "";
  const remoteRef = parts[2] ?? "";

  // Ignore deletions
  if (localSha === "0000000000000000000000000000000000000000" || /^0+$/.test(localSha)) {
    continue;
  }

  if (
    remoteRef === "refs/heads/main" ||
    localRef === "refs/heads/main" ||
    remoteRef === "main" ||
    localRef === "main"
  ) {
    pushingMain = true;
    break;
  }
}

// Only enforce on main branch
if (!pushingMain) {
  process.exit(0);
}

const scriptPath = path.resolve(import.meta.dir, "../scripts/bump-version.ts");

const proc = Bun.spawnSync(
  ["bun", scriptPath, "--hook", "--remote", remoteName],
  {
    stdin: "ignore",
    stdout: "inherit",
    stderr: "inherit",
  }
);

process.exit(proc.exitCode ?? 0);
