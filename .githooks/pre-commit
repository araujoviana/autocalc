#!/usr/bin/env bun
// Reject common secret files and recognizable credentials in staged blobs.

function git(...args: string[]): Uint8Array {
  const proc = Bun.spawnSync(["git", ...args], { stdout: "pipe", stderr: "pipe" });
  if (proc.exitCode !== 0) {
    throw new Error(new TextDecoder().decode(proc.stderr));
  }
  return proc.stdout;
}

const rawPaths = new TextDecoder().decode(git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z")).split("\0");
const blocked = /(^|\/)(\.env(?:\..*)?|\.session\.curl.*|\.aws\/.*|.*\.(?:pem|key|p12|pfx|keystore)|(?:credentials|id_rsa|id_ed25519))(?:$|\/)/i;
const patterns: Array<[string, RegExp]> = [
  ["private key", /-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----/],
  ["AWS access key", /\b(?:AKIA|ASIA)[A-Z0-9]{16}\b/],
  ["GitHub token", /\b(?:gh[pousr]_[A-Za-z0-9_]{36,}|github_pat_[A-Za-z0-9_]{20,})\b/],
  ["authorization header", /authorization\s*:\s*(?:bearer|basic)\s+[A-Za-z0-9._~+/=-]{16,}/i],
];

const failures: Array<[string, string]> = [];
for (const path of rawPaths.filter(Boolean)) {
  if (
    blocked.test(path) ||
    path.startsWith("tests/fixtures/corpus/") ||
    path === "docs/quotes.md" ||
    path.startsWith("docs/reports/") ||
    path.startsWith("docs/private/") ||
    path.startsWith(".codegraph/")
  ) {
    failures.push([path, "sensitive or local file"]);
    continue;
  }
  const blob = new TextDecoder("utf-8", { fatal: false }).decode(git("show", `:${path}`));
  for (const [label, pattern] of patterns) {
    if (pattern.test(blob)) {
      failures.push([path, label]);
      break;
    }
  }
}

if (failures.length > 0) {
  console.error("Commit blocked: possible sensitive data in staged files:");
  for (const [path, label] of failures) {
    console.error(`  ${path}: ${label}`);
  }
  console.error("Unstage or remove sensitive content before committing.");
  process.exit(1);
}
